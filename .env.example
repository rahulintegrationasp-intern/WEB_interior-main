# Server Configuration
PORT=8080

# MongoDB Connection String (MongoDB Atlas or Local URI)
DB=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/interior_studio?retryWrites=true&w=majority

# Cloudinary Image Storage Configuration
CN=your_cloudinary_cloud_name
AK=your_cloudinary_api_key
AS=your_cloudinary_api_secret

# Admin Authentication (server-side only — never hardcode in client)
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_strong_admin_password

# Nodemailer (Gmail SMTP) Configuration for Enquiry Notifications
# EMAIL=your_smtp_email@gmail.com
# PASSWORD=your_gmail_app_password
# RECEIVER_EMAIL=adityasalkar1806@gmail.com

# Client / Frontend Configuration (used in client/.env)
VITE_API_BASE_URL=http://localhost:8080
